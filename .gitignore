# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environment
venv/
env/
.env

# Large GIS & Raster data (جلوگیری از آپلود فایل‌های حجیم)
*.tif
*.tiff
*.dem
*.asc
*.nc
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Output maps and temporary files
outputs/maps/*
!outputs/maps/.gitkeep
